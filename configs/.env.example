# Nomad Dev Stack — Environment Variables
# Copy this file to .env and customize for your setup.
# The installer reads these values in non-interactive mode.

# ── Core Settings ─────────────────────────────────────────────
NOMAD_OS=ubuntu                  # ubuntu | debian | fedora | arch | macos | windows
NOMAD_EDITOR=vscode              # vscode | cursor | windsurf | neovim
NOMAD_MOBILE=android             # android | ios | ipados | chromeos
NOMAD_NETWORK=tailscale          # tailscale | cloudflare_tunnel | ngrok | zerotier | local_only
NOMAD_PORT=8081                  # Port for code-server (avoid 8080, often taken)
NOMAD_AUTOSTART=yes              # yes | no — start on boot via systemd

# ── Network ───────────────────────────────────────────────────
TAILSCALE_HOSTNAME=nomad-dev     # Hostname in Tailscale network
TAILSCALE_AUTH_KEY=              # Optional: pre-authentication key (tskey-auth-...)

# ── Cloudflare Tunnel (if using) ──────────────────────────────
CF_TUNNEL_ID=                    # Your Cloudflare tunnel UUID
CF_CREDENTIALS_FILE=             # Path to tunnel credentials JSON

# ── Authentication ────────────────────────────────────────────
NOMAD_AUTH=password              # password | none (DANGEROUS)
NOMAD_PASSWORD=                  # Leave empty to auto-generate

# ── Paths ─────────────────────────────────────────────────────
NOMAD_WORKSPACE_DIR=~/workspace  # Default workspace directory
NOMAD_CONFIG_DIR=~/.nomad-dev-stack

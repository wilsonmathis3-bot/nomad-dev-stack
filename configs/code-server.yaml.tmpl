# Nomad Dev Stack — code-server configuration template
# This file is generated by the installer based on your selections.
# Edit ~/.config/code-server/config.yaml to change settings later.

# Network binding — 0.0.0.0 allows access from any device on your network
bind-addr: {{BIND_ADDR}}

# Authentication method:
#   password  — Simple password (default, recommended for personal use)
#   none      — No auth (DANGEROUS, only for local trusted networks)
auth: {{AUTH}}

# Password for access (only used when auth is "password")
# Generate a strong random password during installation
password: {{PASSWORD}}

# User data directory — extensions, settings, history
user-data-dir: {{USER_DATA_DIR}}

# Certificate configuration (optional, for HTTPS)
# Leave empty for HTTP (Tailscale provides encryption)
# To use HTTPS, provide paths to cert and key files:
# cert: {{CERT}}
# cert-key: {{CERT_KEY}}

# Disable telemetry
disable-telemetry: true

# Proxy configuration (if behind corporate proxy)
# proxy-domain: example.com
